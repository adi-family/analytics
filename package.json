{
  "name": "adi-analytics",
  "version": "0.1.0",
  "private": true,
  "description": "ADI's first-party analytics collector: a short allowlist of named events, AWS serverless",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:snippet": "bun build snippet/web.js --minify --target browser --outfile dist/web.min.js",
    "build": "bun run build:snippet && bun build src/lambda.ts --target node --format esm --minify --external '@aws-sdk/*' --outfile dist/lambda/index.mjs",
    "test": "bun run build:snippet && bun test",
    "typecheck": "tsc --noEmit",
    "dev": "bun run build:snippet && bun scripts/dev.ts",
    "sync-dictionary": "bun scripts/sync-dictionary.ts",
    "refresh-blocklists": "bun scripts/refresh-blocklists.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-firehose": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@ghostery/adblocker": "^2.20.1",
    "@types/bun": "^1.3.0",
    "typescript": "^5.6.0"
  }
}
